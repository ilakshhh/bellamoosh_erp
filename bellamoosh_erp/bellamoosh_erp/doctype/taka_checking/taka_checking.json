{
  "name": "Taka Checking",
  "module": "Bellamoosh ERP",
  "doctype": "DocType",
  "is_submittable": 1,
  "autoname": "format:TC-{YYYY}-{#####}",
  "fields": [
    {"fieldname": "taka_no", "label": "Taka No", "fieldtype": "Data", "reqd": 1, "in_list_view": 1},
    {"fieldname": "chart_no", "label": "Chart No", "fieldtype": "Data", "reqd": 1, "in_list_view": 1},
    {"fieldname": "color_no", "label": "Color No", "fieldtype": "Data", "in_list_view": 1},
    {"fieldname": "product", "label": "Product", "fieldtype": "Link", "options": "Item", "reqd": 1},
    {"fieldname": "received_date", "label": "Received Date", "fieldtype": "Date", "default": "Today"},
    {"fieldname": "col_break_1", "fieldtype": "Column Break"},
    {"fieldname": "gin_no", "label": "GIN No", "fieldtype": "Data"},
    {"fieldname": "purchase_receipt", "label": "Purchase Receipt", "fieldtype": "Link", "options": "Purchase Receipt", "read_only": 1},
    {"fieldname": "supplier", "label": "Supplier", "fieldtype": "Link", "options": "Supplier"},
    {"fieldname": "star_mark", "label": "Star Mark (Priority)", "fieldtype": "Check"},
    {"fieldname": "status", "label": "Status", "fieldtype": "Select",
      "options": "Pending\nChecked\nCutting Done\nIn Roll\nDispatched", "default": "Pending"},
    {"fieldname": "sec_break_measurements", "label": "Measurements", "fieldtype": "Section Break"},
    {"fieldname": "war_kata_yards", "label": "War Kata (Yards)", "fieldtype": "Float", "reqd": 1},
    {"fieldname": "war_kata_mtrs", "label": "War Kata (Metres)", "fieldtype": "Float", "read_only": 1},
    {"fieldname": "col_break_2", "fieldtype": "Column Break"},
    {"fieldname": "sample", "label": "Sample (Yards)", "fieldtype": "Float", "default": "1"},
    {"fieldname": "wastage", "label": "Wastage (formula, e.g. =0.4+1.99+5)", "fieldtype": "Data"},
    {"fieldname": "total_wastage", "label": "Total Wastage (Yards)", "fieldtype": "Float", "read_only": 1},
    {"fieldname": "sec_break_wastage", "label": "Wastage Breakdown", "fieldtype": "Section Break"},
    {"fieldname": "chindi", "label": "Chindi (0.1–0.49 yds)", "fieldtype": "Float", "read_only": 1},
    {"fieldname": "fant", "label": "Fant (0.5–1.99 yds)", "fieldtype": "Float", "read_only": 1},
    {"fieldname": "col_break_3", "fieldtype": "Column Break"},
    {"fieldname": "good_cut", "label": "Good Cut (2–4.99 yds)", "fieldtype": "Float", "read_only": 1},
    {"fieldname": "super_good_cut", "label": "Super Good Cut (5–6.99 yds)", "fieldtype": "Float", "read_only": 1},
    {"fieldname": "sec_break_packing", "label": "Packing Qty", "fieldtype": "Section Break"},
    {"fieldname": "packing_qty_yards", "label": "Packing Qty (Yards)", "fieldtype": "Float", "read_only": 1},
    {"fieldname": "packing_qty_mtrs", "label": "Packing Qty (Metres)", "fieldtype": "Float", "read_only": 1},
    {"fieldname": "sec_break_conditions", "label": "Conditions", "fieldtype": "Section Break"},
    {"fieldname": "return_condition", "label": "Return Condition", "fieldtype": "Small Text"},
    {"fieldname": "col_break_4", "fieldtype": "Column Break"},
    {"fieldname": "process_condition", "label": "Process Condition", "fieldtype": "Small Text"},
    {"fieldname": "sec_break_cutting", "label": "Cutting Details", "fieldtype": "Section Break"},
    {"fieldname": "cutting_details", "label": "Cutting Details", "fieldtype": "Table",
      "options": "Cutting Detail"}
  ],
  "permissions": [
    {"role": "Bhiwandi Operator", "read": 1, "write": 1, "create": 1, "submit": 1},
    {"role": "Headoffice Manager", "read": 1, "write": 1, "create": 1, "submit": 1, "cancel": 1}
  ]
}
